  {
    "id": "json-a-excel",
    "title": "JSON → Excel",
    "description": "Lee un archivo JSON con una lista de objetos y lo vuelca como tabla",
    "category": "hojas-archivos",
    "tags": ["json", "excel", "conversión"],
    "popularity": 74,
    "requires": [],
    "steps": [
      { "type": "read_file", "data": { "file_path": "~/datos.json", "encoding": "utf8", "target_field": "data" } },
      {
        "type": "code",
        "data": {
          "language": "javascript",
          "output_var": "tabla",
          "code": "(async () => {\nconst fs = await import('node:fs');\nconst objetos = JSON.parse(fs.readFileSync(String.raw`{{ $json.file_path }}`, 'utf8'));\nconst lista = Array.isArray(objetos) ? objetos : [objetos];\nconst cabecera = Object.keys(lista[0] || {});\nconst filas = lista.map((o) => cabecera.map((c) => String(o[c] === undefined ? '' : o[c])));\nconsole.log(JSON.stringify({ cabecera: cabecera, filas: filas }));\n})();"
        }
      },
      {
        "type": "excel_local",
        "data": {
          "file_path": "datos.xlsx",
          "header": "{{ $json.cabecera }}",
          "values": "{{ $json.filas }}",
          "delimiter": ",",
          "overwrite": true,
          "format": "xlsx"
        }
      }
    ]
  },
  {
    "id": "csv-a-json",
    "title": "CSV → JSON",
    "description": "Convierte un CSV en una lista de objetos JSON listos para consumir",
    "category": "hojas-archivos",
    "tags": ["csv", "json", "conversión"],
    "popularity": 72,
    "requires": [],
    "steps": [
      { "type": "read_file", "data": { "file_path": "~/datos.csv", "encoding": "utf8", "target_field": "data" } },
      {
        "type": "code",
        "data": {
          "language": "javascript",
          "output_var": "json",
          "code": "(async () => {\nconst fs = await import('node:fs');\nconst lineas = fs.readFileSync(String.raw`{{ $json.file_path }}`, 'utf8').trim().split(/\\r?\\n/);\nconst cabecera = lineas[0].split(',');\nconst objetos = lineas.slice(1).map((l) => {\n  const celdas = l.split(',');\n  const obj = {};\n  cabecera.forEach((c, i) => { obj[c] = celdas[i] === undefined ? '' : celdas[i]; });\n  return obj;\n});\nconsole.log(JSON.stringify({ texto: JSON.stringify(objetos, null, 2), filas: objetos.length }));\n})();"
        }
      },
      { "type": "write_file", "data": { "file_path": "~/datos.json", "content": "{{ $json.texto }}", "encoding": "utf8", "append": false } }
    ]
  },
