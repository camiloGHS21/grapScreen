  {
    "id": "csv-limpio",
    "title": "Limpiar un CSV",
    "description": "Quita líneas vacías y repetidas de un CSV y guarda el resultado aparte",
    "category": "hojas-archivos",
    "tags": ["csv", "limpieza", "deduplicar"],
    "popularity": 76,
    "requires": [],
    "steps": [
      { "type": "read_file", "data": { "file_path": "~/datos.csv", "encoding": "utf8", "target_field": "data" } },
      {
        "type": "code",
        "data": {
          "language": "javascript",
          "output_var": "limpio",
          "code": "(async () => {\nconst fs = await import('node:fs');\nconst lineas = fs.readFileSync(String.raw`{{ $json.file_path }}`, 'utf8').trim().split(/\\r?\\n/);\nconst vistas = new Set([lineas[0]]);\nconst salida = [lineas[0]];\nfor (const linea of lineas.slice(1)) {\n  const limpia = linea.trim();\n  if (!limpia || vistas.has(limpia)) continue;\n  vistas.add(limpia);\n  salida.push(limpia);\n}\nconsole.log(JSON.stringify({ texto: salida.join(String.fromCharCode(10)), filas: salida.length }));\n})();"
        }
      },
      { "type": "write_file", "data": { "file_path": "~/datos-limpio.csv", "content": "{{ $json.texto }}", "encoding": "utf8", "append": false } }
    ]
  },
