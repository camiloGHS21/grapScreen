[
  {
    "id": "csv-a-excel",
    "title": "CSV → Excel",
    "description": "Lee un CSV del disco y lo convierte en un libro .xlsx conservando la cabecera",
    "category": "hojas-archivos",
    "tags": ["csv", "excel", "xlsx", "conversión"],
    "popularity": 84,
    "requires": [],
    "steps": [
      { "type": "read_file", "data": { "file_path": "~/datos.csv", "encoding": "utf8", "target_field": "data" } },
      {
        "type": "code",
        "data": {
          "language": "javascript",
          "output_var": "tabla",
          "code": "(async () => {\nconst fs = await import('node:fs');\nconst lineas = fs.readFileSync(String.raw`{{ $json.file_path }}`, 'utf8').trim().split(/\\r?\\n/);\nconst cabecera = lineas[0].split(',');\nconst filas = lineas.slice(1).map((l) => l.split(','));\nconsole.log(JSON.stringify({ cabecera: cabecera, filas: filas }));\n})();"
        }
      },
      {
        "type": "excel_local",
        "data": {
          "file_path": "datos.xlsx",
          "header": "{{ $json.cabecera }}",
          "values": "{{ $json.filas }}",
          "delimiter": ",",
          "overwrite": true,
          "format": "xlsx"
        }
      }
    ]
  },
