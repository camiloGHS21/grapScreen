    "steps": [
      { "type": "read_file", "data": { "file_path": "~/datos.csv", "encoding": "utf8", "target_field": "data" } },
      {
        "type": "code",
        "data": {
          "language": "javascript",
          "output_var": "ordenado",
          "code": "(async () => {\nconst fs = await import('node:fs');\nconst lineas = fs.readFileSync(String.raw`{{ $json.file_path }}`, 'utf8').trim().split(/\\r?\\n/);\nconst filas = lineas.slice(1).sort((a, b) => a.split(',')[0].localeCompare(b.split(',')[0]));\nconsole.log(JSON.stringify({ texto: [lineas[0]].concat(filas).join(String.fromCharCode(10)) }));\n})();"
