  {
    "id": "formulario-con-validacion",
    "title": "Formulario con puerta de validación",
    "description": "Solo guarda en Excel si el paso de control marca el registro como válido",
    "category": "formularios-datos",
    "tags": ["formulario", "validación", "condición", "excel"],
    "popularity": 76,
    "requires": [],
    "steps": [
      {
        "type": "set_var",
        "data": { "name": "estado", "value": "ok" }
      },
      {
        "type": "form",
        "data": {
          "fields": [
            { "id": "nombre", "label": "Nombre", "type": "text", "required": true },
            { "id": "email", "label": "Email", "type": "email", "required": true }
          ]
        }
      },
      {
        "type": "condition",
        "data": {
          "description": "¿El registro pasa la revisión?",
          "condition_type": "expression",
          "expression": "\"{{ estado }}\" == \"ok\""
        }
      },
      {
        "type": "excel_local",
        "data": {
          "file_path": "registros.xlsx",
          "header": "[\"Nombre\",\"Email\"]",
          "values": "[[\"{{ nombre }}\",\"{{ email }}\"]]",
          "delimiter": ",",
          "overwrite": false,
          "format": "xlsx"
        }
      }
    ]
