  {
    "id": "form-a-excel",
    "title": "Formulario → Excel",
    "description": "Pide nombre, email y teléfono, y añade la fila a un libro de Excel",
    "category": "formularios-datos",
    "tags": ["formulario", "excel", "registro", "xlsx"],
    "popularity": 96,
    "requires": [],
    "steps": [
      {
        "type": "form",
        "data": {
          "fields": [
            { "id": "nombre", "label": "Nombre", "type": "text", "required": true },
            { "id": "email", "label": "Email", "type": "email", "required": true },
            { "id": "telefono", "label": "Teléfono", "type": "phone", "required": true }
          ]
        }
      },
      {
        "type": "excel_local",
        "data": {
          "file_path": "registros.xlsx",
          "header": "[\"Nombre\",\"Email\",\"Teléfono\"]",
          "values": "[[\"{{ nombre }}\",\"{{ email }}\",\"{{ telefono }}\"]]",
          "delimiter": ",",
          "overwrite": false,
          "format": "xlsx"
        }
      }
    ]
  },
