  {
    "id": "resumen-con-ia",
    "title": "Resumir un texto con IA",
    "description": "El usuario pega un texto largo y el modelo devuelve un resumen breve",
    "category": "ia-texto",
    "tags": ["ia", "resumen", "llm", "texto"],
    "popularity": 90,
    "requires": ["ai"],
    "steps": [
