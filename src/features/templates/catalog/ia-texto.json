      {
        "type": "llm_chain",
        "data": {
          "base_url": "https://api.openai.com/v1",
          "api_key": "",
          "model": "gpt-4o-mini",
          "system_prompt": "Resume en tres frases como máximo, en español.",
          "prompt": "{{ texto }}",
          "temperature": 0.3,
          "max_tokens": 512,
          "result_field": "text",
          "output_var": "resumen"
        }
      },
      { "type": "write_file", "data": { "file_path": "~/resumen.txt", "content": "{{ $json.text }}", "encoding": "utf8", "append": false } }
    ]
  },
