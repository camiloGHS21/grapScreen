  {
    "id": "enviar-datos-a-una-api",
    "title": "Enviar datos a una API",
    "description": "Recoge datos por formulario y los publica en un endpoint por POST",
    "category": "web-apis",
    "tags": ["api", "post", "http", "formulario"],
    "popularity": 82,
    "requires": [],
    "steps": [
      {
        "type": "form",
        "data": {
          "fields": [
            { "id": "nombre", "label": "Nombre", "type": "text", "required": true },
            { "id": "email", "label": "Email", "type": "email", "required": true }
          ]
        }
      },
      {
        "type": "http_request",
        "data": {
          "method": "POST",
          "url": "https://httpbin.org/post",
          "headers": "{\"Content-Type\":\"application/json\"}",
          "body": "{\"nombre\":\"{{ nombre }}\",\"email\":\"{{ email }}\"}",
          "output_var": "respuesta"
        }
      },
      { "type": "write_file", "data": { "file_path": "~/envio-api.json", "content": "{{ respuesta }}\n", "encoding": "utf8", "append": true } }
    ]
  },
